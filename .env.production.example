# Copie para .env.production e substitua todos os valores CHANGE_ME.
COMPOSE_PROJECT_NAME=cidadefacil
APP_DOMAIN=cidadefacil.seudominio.gov.br
ACME_EMAIL=ti@seudominio.gov.br

POSTGRES_DB=cidadefacil
POSTGRES_USER=cidadefacil
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
# A senha abaixo precisa estar codificada para URL caso contenha @, :, /, # ou %.
DATABASE_URL=postgresql://cidadefacil:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/cidadefacil

# Usados apenas pelo comando de inicialização administrativa.
ADMIN_NAME=Administrador Municipal
ADMIN_EMAIL=admin@seudominio.gov.br
ADMIN_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_PASSWORD

PUBLIC_MUNICIPALITY_SLUG=seropedica-rj
AUDIT_IP_SALT=CHANGE_ME_USE_A_THIRD_LONG_RANDOM_VALUE
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_CREATE_MAX=5
RATE_LIMIT_PUBLIC_CREATE_WINDOW_MS=3600000
RATE_LIMIT_PUBLIC_QUERY_MAX=30
RATE_LIMIT_PUBLIC_QUERY_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_UPLOAD_MAX=10
RATE_LIMIT_PUBLIC_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_GEOCODE_MAX=30
RATE_LIMIT_GEOCODE_WINDOW_MS=3600000
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
SLA_WORKER_INTERVAL_MS=60000

# Credenciais fornecidas pelo parceiro oficial do WhatsApp da entidade pública.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
WHATSAPP_APP_SECRET=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_GRAPH_VERSION=CHANGE_ME

# Alternativa temporária de homologação com Twilio Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_WEBHOOK_URL=
